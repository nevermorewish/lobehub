# Same PostgreSQL database as LobeHub. Admin only migrates admin_* tables.
DATABASE_URL=postgresql://postgres:replace-me@postgresql:5200/lobechat?sslmode=disable
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-password
ADMIN_PUBLIC_URL=http://localhost:3211
# Generate each separately: openssl rand -base64 32
ADMIN_ENCRYPTION_KEY=
ADMIN_INTEGRATION_TOKEN=
PORT=3211
