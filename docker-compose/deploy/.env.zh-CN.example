# Proxy，如果你需要的话（比如你使用 GitHub 作为鉴权服务提供商）
# HTTP_PROXY=http://localhost:7890
# HTTPS_PROXY=http://localhost:7890

# 允许登录的邮箱地址，用英文逗号分隔
# 设置后只有列表中的邮箱可以登录，其他用户可以注册但无法登录
# 留空则允许所有用户注册登录
# AUTH_ALLOWED_EMAILS=user1@example.com,user2@example.com

# 禁用用户注册（仅允许 SSO 登录）
# 设置为 1 后，用户无法通过邮箱密码注册，只能通过 SSO 登录
# AUTH_DISABLE_EMAIL_PASSWORD=1

# ===================
# ===== 预设配置 =====
# ===================
# 如没有特殊需要不用更改
LOBE_PORT=3210
APP_URL=https://frogclaw.chat
# 内部应用URL是可选的，用于服务器内部调用
# 如果没有设置，默认使用 APP_URL
# INTERNAL_APP_URL=http://localhost:3210

# 密钥配置（由 setup.sh 自动生成）
KEY_VAULTS_SECRET=
AUTH_SECRET=

# PostgreSQL 配置
LOBE_DB_NAME=lobechat
POSTGRES_PASSWORD=

# RustFS S3 配置
# S3_ENDPOINT 会直接作为预签名 URL 返回给浏览器，必须是浏览器能访问的地址
# 需要在 Nginx 中为 s3.frogclaw.chat 配置独立的 server block 反代到 127.0.0.1:9000
S3_ENDPOINT=https://tos-s3-cn-beijing.volces.com
S3_PUBLIC_DOMAIN=https://tos-s3-cn-beijing.volces.com
# 火山云 TOS S3 兼容接口（公有读写，无需 AK/SK）
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_LOBE_BUCKET=huanxing
# 对象路径前缀 lobehub/ 目前不能通过 Compose 的 S3_BUCKET 配置；如需此前缀，需在应用的 S3 存储配置中单独支持。

JWKS_KEY=

# ==========================================
# AI 模型 API 配置 (OpenAI)
# ==========================================
# 填入你的 OpenAI API Key 或者是中继商提供的 Key
OPENAI_API_KEY=

# 如果你使用的是国内代理或者中转 API，请在此处填写中转商的地址
# ⚠️ 注意：绝大部分中转接口地址，结尾都必须带上 `/v1` 才能生效！
OPENAI_PROXY_URL=https://frogclaw.com/v1

# ==========================================
# AI 模型 API 配置 (Anthropic Claude)
# ==========================================
# 填入你的 Anthropic API Key
ANTHROPIC_API_KEY=

# 如果你使用的是代理或者中转 API，请在此处填写中转地址，通常以 /v1 结尾
ANTHROPIC_PROXY_URL=https://frogclaw.com

# ==========================================
# AI 模型 API 配置 (Google Gemini)
# ==========================================
# 填入你的 Google Gemini API Key
GOOGLE_API_KEY=

# 如果你使用的是代理或者中转 API，请在此处填写中转地址，通常以 /v1 结尾
GOOGLE_PROXY_URL=https://frogclaw.com

# LobeHub PostgreSQL connection URL (keep actual credentials in .env)
DATABASE_URL=
